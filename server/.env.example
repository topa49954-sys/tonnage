# Скопируй в .env и заполни.
#
# Пароль для входа в приложение. Пользователь один — ты.
# Вариант попроще:
TONNAGE_PASSWORD=смени_меня
#
# Вариант правильнее: получи хеш командой `npm run hash -- твойпароль`,
# вставь его сюда и УДАЛИ строку TONNAGE_PASSWORD выше.
# TONNAGE_PASSWORD_HASH=scrypt$...

# Порт и адрес. За nginx оставляй 127.0.0.1 — тогда сервер не торчит
# наружу напрямую и снаружи доступен только через HTTPS.
PORT=8080
HOST=127.0.0.1

# Где лежат база и ключ подписи токенов. Каталог бэкапить целиком.
# TONNAGE_DATA=/var/lib/tonnage
