{
  "name": "tonnage-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сервер приложения «Тоннаж»: статика + синхронизация дневника тренировок",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings src/index.js",
    "dev": "node --env-file-if-exists=.env --no-warnings --watch src/index.js",
    "hash": "node --no-warnings src/index.js hash",
    "icons": "node --no-warnings src/make-icons.js",
    "sim": "node --no-warnings src/sim.js",
    "test": "node --no-warnings src/test-merge.js",
    "smoke": "node --no-warnings test/smoke.mjs"
  },
  "dependencies": {},
  "_comment": "Зависимостей нет намеренно. jsdom нужен только дымовому тесту и ставится по требованию: npm i --no-save jsdom"
}
